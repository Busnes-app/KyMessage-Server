-- Generated by kymessages matrix-init. Idempotent. On a new data volume Postgres runs it after
-- init.sql. init.sql runs only on an empty volume, so after deleting secrets/synapse_db_password
-- or secrets/mas_db_password (rotation) and re-running matrix-init, apply it on the running stack
-- before restarting Synapse and MAS:
--   docker compose exec -T postgres psql -U postgres -v ON_ERROR_STOP=1 -f /docker-entrypoint-initdb.d/role-passwords.sql
ALTER ROLE synapse PASSWORD {{ sqlq .S.synapse_db_password }};
ALTER ROLE mas PASSWORD {{ sqlq .S.mas_db_password }};
