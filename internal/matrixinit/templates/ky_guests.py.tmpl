# Generated by kymessages matrix-init. Re-running it rewrites this file.
#
# Confines meeting guests (docs/superpowers/specs/2026-10-18-kymessages-meeting-rooms-design.md,
# "Confinement"): a local user whose localpart starts with "guest-" is a short-lived account
# KyMessages made for one meeting room. It may act only in a room where the console has sent the
# state event app.kymessages.guest with the guest's localpart as state key. Everything else a
# guest might do to reach people outside that room is refused here, in Synapse, whatever client
# it uses.
import logging

from synapse.api.errors import Codes
from synapse.module_api import NOT_SPAM, ModuleApi

logger = logging.getLogger(__name__)

PREFIX = "guest-"
MARKER = "app.kymessages.guest"
# The only state a guest may send: its own membership and its call membership.
GUEST_STATE = {"m.room.member", "org.matrix.msc3401.call.member"}
SUFFIX = " (guest)"


class GuestConfinement:
    def __init__(self, config: dict, api: ModuleApi):
        self._api = api
        self._console = config["console"]
        api.register_spam_checker_callbacks(
            user_may_create_room=self.refuse_guest,
            user_may_invite=self.user_may_invite,
            user_may_send_3pid_invite=self.user_may_send_3pid_invite,
            user_may_join_room=self.user_may_join_room,
            user_may_create_room_alias=self.refuse_guest,
            user_may_publish_room=self.refuse_guest,
            check_username_for_spam=self.check_username_for_spam,
        )
        api.register_media_repository_callbacks(
            is_user_allowed_to_upload_media_of_size=self.may_upload,
        )
        api.register_third_party_rules_callbacks(
            check_event_allowed=self.check_event_allowed,
        )

    @staticmethod
    def parse_config(config: dict) -> dict:
        if not isinstance(config.get("console"), str):
            raise ValueError("ky_guests: console is required")
        return config

    def _guest(self, user_id: str) -> bool:
        return user_id.startswith("@" + PREFIX) and self._api.is_mine(user_id)

    def _marked(self, state, user_id: str) -> bool:
        ev = state.get((MARKER, user_id[1:].split(":", 1)[0]))
        return ev is not None and ev.sender == self._console

    async def _room_marks(self, room_id: str, user_id: str) -> bool:
        key = (MARKER, user_id[1:].split(":", 1)[0])
        return self._marked(await self._api.get_room_state(room_id, [key]), user_id)

    async def refuse_guest(self, user_id: str, *_args):
        return Codes.FORBIDDEN if self._guest(user_id) else NOT_SPAM

    async def user_may_invite(self, inviter: str, invitee: str, room_id: str):
        if self._guest(inviter):
            return Codes.FORBIDDEN
        if self._guest(invitee) and not await self._room_marks(room_id, invitee):
            return Codes.FORBIDDEN
        return NOT_SPAM

    async def user_may_send_3pid_invite(self, inviter: str, *_args):
        return Codes.FORBIDDEN if self._guest(inviter) else NOT_SPAM

    async def user_may_join_room(self, user_id: str, room_id: str, is_invited: bool):
        if self._guest(user_id) and not (is_invited and await self._room_marks(room_id, user_id)):
            return Codes.FORBIDDEN
        return NOT_SPAM

    async def check_username_for_spam(self, _profile, requester_id: str = "") -> bool:
        # True hides the result: a guest's directory search finds nobody.
        return self._guest(requester_id)

    async def may_upload(self, user_id: str, _size: int) -> bool:
        return not self._guest(user_id)

    async def check_event_allowed(self, event, state):
        sender = event.sender
        if not self._guest(sender):
            return True, None
        if event.type == "m.room.member" and event.state_key == sender and event.membership == "leave":
            return True, None  # leaving, or being parted on deactivation, is always allowed
        if not self._marked(state, sender):
            return False, None
        if event.is_state() and event.type not in GUEST_STATE:
            return False, None
        if event.type == "m.room.member":
            # Members must always see the suffix: a guest cannot rename itself out of it.
            name = event.content.get("displayname")
            named = isinstance(name, str) and name.endswith(SUFFIX)
            if event.state_key != sender or event.membership not in ("knock", "join") or not (named or name is None and event.membership == "knock"):
                return False, None
        return True, None
