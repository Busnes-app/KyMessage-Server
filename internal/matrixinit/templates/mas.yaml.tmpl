# Generated by kymessages matrix-init. Re-running it rewrites this file; secrets stay.
http:
  public_base: {{ q (print .In.AuthHost "/") }}
  issuer: {{ q (print .In.AuthHost "/") }}
  listeners:
    # Public: no compat (legacy /login) resource and no admin API (that is the admin listener).
    - name: web
      resources:
        - name: discovery
        - name: human
        - name: oauth
        - name: graphql
        - name: assets
      binds:
        - address: "[::]:8080"
    # Internal: the admin API (and its token endpoint) for KyMessages' offboarding sync. Bound
    # only to mas-admin, MAS's alias on the internal matrix-admin network; never proxied.
    - name: admin
      resources:
        - name: adminapi
        - name: oauth
      binds:
        - host: mas-admin
          port: 8081
database:
  host: postgres
  username: mas
  password: {{ q .S.mas_db_password }}
  database: mas
secrets:
  encryption: {{ q .S.mas_encryption }}
  keys:
    - key: {{ q .S.mas_signing_rsa }}
    - key: {{ q .S.mas_signing_ec }}
clients:
  - client_id: {{ q .S.mas_admin_client_id }}
    client_auth_method: client_secret_basic
    client_secret: {{ q .S.mas_admin_client_secret }}
policy:
  data:
    admin_clients:
      - {{ q .S.mas_admin_client_id }}
passwords:
  enabled: false
account:
  password_registration_enabled: false
  password_change_allowed: false
  password_recovery_enabled: false
  email_change_allowed: false
  displayname_change_allowed: true
  account_deactivation_allowed: false
matrix:
  kind: synapse
  homeserver: {{ q .In.ServerName }}
  secret: {{ q .S.mas_synapse_shared_secret }}
  endpoint: http://synapse:8008/
upstream_oauth2:
  providers:
    - id: {{ q .S.upstream_provider_id }}
      human_name: KyIdentity
      issuer: {{ q .In.Issuer }}
      client_id: {{ q .In.ClientID }}
      client_secret: {{ q .S.kyidentity_client_secret }}
      token_endpoint_auth_method: client_secret_basic
      on_backchannel_logout: logout_all
      scope: "openid profile email"
      claims_imports:
        localpart:
          action: require
          # preferred_username, lowercased, every character outside [a-z0-9._=-] replaced by "_".
          template: {{ q .Localpart }}
          on_conflict: fail
        displayname:
          action: force
          template: {{ q .DisplayName }}
        email:
          action: force
          template: {{ q .Email }}
