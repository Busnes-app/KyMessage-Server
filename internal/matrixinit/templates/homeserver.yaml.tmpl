# Generated by kymessages matrix-init. Re-running it rewrites this file; secrets stay.
server_name: {{ q .In.ServerName }}
public_baseurl: {{ q (print .In.MatrixHost "/") }}
listeners:
  - port: 8008
    type: http
    tls: false
    x_forwarded: true
    resources:
      # OpenID userinfo authenticates calls; no federation resource.
      - names: [client, openid]
        compress: false
database:
  name: psycopg2
  args:
    user: synapse
    password: {{ q .S.synapse_db_password }}
    dbname: synapse
    host: postgres
    cp_min: 2
    cp_max: 10
media_store_path: /media
report_stats: false
macaroon_secret_key: {{ q .S.synapse_macaroon_secret_key }}
form_secret: {{ q .S.synapse_form_secret }}
signing_key_path: /config/signing.key
# Federation off: an empty allow-list denies every server; no key servers are trusted.
federation_domain_whitelist: []
trusted_key_servers: []
enable_registration: false
allow_guest_access: false
encryption_enabled_by_default_for_room_type: all
matrix_authentication_service:
  enabled: true
  endpoint: http://mas:8080/
  secret: {{ q .S.mas_synapse_shared_secret }}

# Element Call uses delayed leave events to clean up disconnected participants.
experimental_features:
  msc4143_enabled: true
  msc4222_enabled: true
max_event_delay_duration: 24h
rc_message:
  per_second: 0.5
  burst_count: 30
rc_delayed_event_mgmt:
  per_second: 1
  burst_count: 20
matrix_rtc:
  transports:
    - type: livekit
      livekit_service_url: {{ q (print .In.AdminHost "/api/matrix/rtc") }}
