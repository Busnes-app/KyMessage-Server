+}
+
+.ky-appearance .ky-appearance-mode {
+  display: block;
+  padding-inline-end: 28px;
+  color: var(--ink, var(--ky-ink-muted));
+  font-size: 12px;
+  line-height: 1.5;
+  white-space: normal;
+  overflow-wrap: anywhere;
+}
